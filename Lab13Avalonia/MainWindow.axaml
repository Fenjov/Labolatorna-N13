<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lab13Avalonia.MainWindow"
        Title="Лабораторна робота №13 - Спрайт-анімація" Width="600" Height="400">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock Text="Спрайтова анімація" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        
        <Border BorderBrush="Black" BorderThickness="2" Background="LightGray" Width="150" Height="150">
            <Image Name="SpriteImage" Stretch="Uniform"/>
        </Border>
        
        <TextBlock Name="ErrorText" Foreground="Red" HorizontalAlignment="Center" TextWrapping="Wrap"/>

        <Button Name="ToggleAnimBtn" Content="Старт / Стоп" Click="ToggleAnimBtn_Click" 
                Width="150" HorizontalContentAlignment="Center" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
    </StackPanel>
</Window>